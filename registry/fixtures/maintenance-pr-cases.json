{
  "schemaVersion": 1,
  "description": "Canonical observer and M2 data envelope, deterministic allowlisted output plan, and bounded PR-writer refusal cases.",
  "allowedArtifacts": [
    "registry/maintenance-findings.json",
    "registry/source-baseline.json",
    "registry/evidence/maintenance-review.json",
    "registry/evidence/maintenance-review.md",
    "packages/typescript/package.json",
    "packages/rust/Cargo.toml",
    "packages/python/pyproject.toml",
    "packages/python/src/erpc_sdk/__init__.py",
    "packages/ruby/lib/erpc_sdk/version.rb",
    "Cargo.lock",
    "CHANGELOG.md",
    "registry/token-catalog.json",
    "registry/dex-catalog.json",
    "registry/token-rankings.json",
    "registry/discovery-state.json",
    "packages/typescript/src/generated/token_catalog.ts",
    "packages/rust/src/generated/token_catalog.rs",
    "packages/python/src/erpc_sdk/_token_catalog_data.py",
    "packages/go/token_catalog_generated.go",
    "packages/ruby/lib/erpc_sdk/generated/token_catalog.rb",
    "packages/typescript/src/generated/dex_catalog.ts",
    "packages/rust/src/generated/dex_catalog.rs",
    "packages/python/src/erpc_sdk/_dex_catalog_data.py",
    "packages/go/dex_catalog_generated.go",
    "packages/ruby/lib/erpc_sdk/generated/dex_catalog.rb",
    "packages/typescript/src/generated/token_rankings.ts",
    "packages/rust/src/generated/token_rankings.rs",
    "packages/python/src/erpc_sdk/_token_rankings_data.py",
    "packages/go/token_rankings_generated.go",
    "packages/ruby/lib/erpc_sdk/generated/token_rankings.rb"
  ],
  "canonicalEnvelopeKeys": ["receipts", "findings", "reviewCandidate"],
  "dataObservationKind": "erpc-sdk-data-maintenance-observation",
  "dataObservationFiles": ["discovery-receipts.json", "pool-receipts.json", "ranking-receipts.json"],
  "trustedCheckoutInputs": [
    "registry/token-catalog.json",
    "registry/observer-config.json",
    "registry/maintenance-findings.json",
    "registry/source-baseline.json"
  ],
  "refuse": [
    "observer envelope keys other than receipts, findings, and reviewCandidate",
    "runtime catalog or generated SDK artifact paths",
    "absolute paths and traversal segments",
    "artifact code execution or patch application",
    "source/catalog/config digest mismatch",
    "malformed or stale same-run receipts/findings/reviewCandidate",
    "human-edited bot branch without matching managed provenance",
    "main moving after the frozen lease",
    "workspace that is not clean, pinned, and promotable",
    "unexpected paths in the existing or proposed branch diff",
    "compare-and-swap branch conflicts",
    "managed branch parent, declared output path set, or byte-exact content digest mismatch",
    "workflow run whose returned head or run identity is not bound to the bot commit",
    "workflow run that lacks the provenance artifact or any required-ci job",
    "pool or ranking receipts collected against the pre-discovery catalog",
    "catalog promotion that removes an old full record, alias, or native wrap",
    "automatic approval, merge, tag, release, or publication"
  ],
  "workflowDispatch": {
    "workflowPath": ".github/workflows/ci.yml",
    "refs": ["codex/registry-maintenance", "codex/release-preparation"],
    "inputs": ["expected_head_sha", "base_sha"],
    "apiVersion": "2026-03-10"
  },
  "managedProvenance": {
    "required": ["managedBy", "branch", "baseSha", "parentSha", "headSha", "semanticFingerprint", "outputDigest", "contentDigest", "outputPaths"],
    "replacement": "GraphQL updateRefs with exact beforeOid and force=true for the one authenticated bot ref"
  },
  "releaseOutputPaths": [
    "packages/typescript/package.json",
    "packages/rust/Cargo.toml",
    "packages/python/pyproject.toml",
    "packages/python/src/erpc_sdk/__init__.py",
    "packages/ruby/lib/erpc_sdk/version.rb",
    "Cargo.lock",
    "CHANGELOG.md"
  ],
  "bootstrap": {
    "sourceCount": 41,
    "requiresStatus": "complete",
    "neverWritesPlaceholder": true
  }
}
