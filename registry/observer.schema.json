{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/elsoul/erpc-sdk/blob/main/registry/observer.schema.json",
  "title": "ERPC token catalog observation artifacts",
  "description": "Strict envelope for the read-only registry observer. Receipts retain bounded RPC/source evidence, findings are stable maintenance records, and the review candidate contains human-review proposals only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipts", "findings", "reviewCandidate"],
  "properties": {
    "receipts": { "$ref": "#/$defs/receipts" },
    "findings": { "$ref": "#/$defs/findings" },
    "reviewCandidate": { "$ref": "#/$defs/reviewCandidate" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "status": {
      "type": "string",
      "enum": ["complete", "partial", "preflight-failed", "review"]
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clean", "pinned", "promotable"],
      "properties": {
        "clean": { "type": "boolean" },
        "pinned": { "type": "boolean" },
        "promotable": { "type": "boolean" }
      }
    },
    "networkReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "chainId", "endpointId", "hostname", "status"],
      "properties": {
        "network": { "enum": ["ethereum", "avalancheC", "solana"] },
        "chainId": { "type": "string" },
        "endpointId": { "type": "string", "minLength": 1 },
        "hostname": { "type": "string", "minLength": 1 },
        "status": { "enum": ["success", "failed", "partial"] },
        "errorCode": { "type": ["string", "null"] },
        "rpcChainId": { "type": "string" },
        "blockNumber": { "type": "string", "pattern": "^0x[0-9a-f]+$" },
        "genesisHash": { "type": "string" },
        "anchorSlot": { "type": "integer", "minimum": 0 }
      }
    },
    "deploymentReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deploymentId", "chainId", "standard", "address", "status", "verification", "errorCode"],
      "properties": {
        "deploymentId": { "type": "string", "minLength": 1 },
        "chainId": { "type": "string", "minLength": 1 },
        "standard": { "enum": ["native", "erc20", "spl-token", "spl-token-2022"] },
        "address": { "type": ["string", "null"] },
        "status": { "enum": ["success", "failed", "skipped"] },
        "verification": { "enum": ["protocol-declared", "rpc", "rpc-account-info", "skipped"] },
        "errorCode": { "type": ["string", "null"] },
        "networkIdentity": { "type": "string" },
        "blockNumber": { "type": "string", "pattern": "^0x[0-9a-f]+$" },
        "codeNonEmpty": { "type": "boolean" },
        "observedDecimals": { "type": ["integer", "null"] },
        "observedSymbol": { "type": "string" },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 255 },
        "symbol": { "type": "string" },
        "symbolSource": { "type": "string" },
        "anchorSlot": { "type": "integer", "minimum": 0 },
        "contextSlot": { "type": "integer", "minimum": 0 },
        "owner": { "type": "string" },
        "parsedType": { "type": ["string", "null"] }
      }
    },
    "sourceReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "hostname", "mode", "status"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "hostname": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["static-bytes", "semantic-signals"] },
        "status": { "enum": ["success", "failed", "partial"] },
        "httpStatus": { "type": "integer", "minimum": 100, "maximum": 599 },
        "bodySha256": { "$ref": "#/$defs/sha256" },
        "fingerprint": { "$ref": "#/$defs/sha256" },
        "errorCode": { "type": "string", "minLength": 1 },
        "finalUrl": { "type": "string", "pattern": "^https://" },
        "redirects": { "type": "integer", "minimum": 0, "maximum": 3 },
        "signalCount": { "type": "integer", "minimum": 1 }
      }
    },
    "receipts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "artifactKind", "status", "sourceSha", "catalogDigest", "configDigest", "workspace", "networks", "deployments", "sources"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "artifactKind": { "const": "observation-receipts" },
        "status": { "enum": ["complete", "partial", "preflight-failed"] },
        "sourceSha": { "$ref": "#/$defs/sourceSha" },
        "catalogDigest": { "$ref": "#/$defs/sha256" },
        "configDigest": { "$ref": "#/$defs/sha256" },
        "workspace": { "$ref": "#/$defs/workspace" },
        "networks": { "type": "array", "items": { "$ref": "#/$defs/networkReceipt" } },
        "deployments": { "type": "array", "minItems": 60, "maxItems": 60, "items": { "$ref": "#/$defs/deploymentReceipt" } },
        "sources": { "type": "array", "minItems": 41, "maxItems": 41, "items": { "$ref": "#/$defs/sourceReceipt" } }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "subjectId", "fingerprint", "code", "severity"],
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "subjectId": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/sha256" },
        "code": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "review", "action"] }
      }
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "artifactKind", "status", "catalogDigest", "configDigest", "findings"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "artifactKind": { "const": "maintenance-findings" },
        "status": { "enum": ["complete", "partial"] },
        "catalogDigest": { "$ref": "#/$defs/sha256" },
        "configDigest": { "$ref": "#/$defs/sha256" },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "subjectId", "fingerprint", "reasonCode", "manualReview"],
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "subjectId": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/sha256" },
        "reasonCode": { "type": "string", "minLength": 1 },
        "manualReview": { "type": "string", "minLength": 1 }
      }
    },
    "reviewCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "artifactKind", "status", "sourceSha", "catalogDigest", "configDigest", "workspace", "baseline", "actionRequired", "proposals", "manualReviewInstructions"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "artifactKind": { "const": "maintenance-review-candidate" },
        "status": { "enum": ["complete", "partial", "review"] },
        "sourceSha": { "$ref": "#/$defs/sourceSha" },
        "catalogDigest": { "$ref": "#/$defs/sha256" },
        "configDigest": { "$ref": "#/$defs/sha256" },
        "workspace": { "$ref": "#/$defs/workspace" },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["present", "eligibleBootstrap"],
          "properties": {
            "present": { "type": "boolean" },
            "eligibleBootstrap": { "type": "boolean" }
          }
        },
        "actionRequired": { "type": "boolean" },
        "proposals": { "type": "array", "items": { "$ref": "#/$defs/proposal" } },
        "manualReviewInstructions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "observerConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "rpc", "sources"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "rpc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ethereum", "avalancheC", "solana"],
          "properties": {
            "ethereum": { "$ref": "#/$defs/rpcEndpoint" },
            "avalancheC": { "$ref": "#/$defs/rpcEndpoint" },
            "solana": { "$ref": "#/$defs/rpcEndpoint" }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 41,
          "items": { "$ref": "#/$defs/sourceConfig" }
        }
      }
    },
    "rpcEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpointId", "chainId", "url", "hostname", "reviewedHosts"],
      "properties": {
        "endpointId": { "type": "string", "minLength": 1 },
        "chainId": { "type": "string", "minLength": 1 },
        "expectedRpcChainId": { "type": "string", "pattern": "^0x[0-9a-f]+$" },
        "expectedGenesisHash": { "type": "string", "minLength": 32 },
        "url": { "type": "string", "pattern": "^https://" },
        "hostname": { "type": "string", "minLength": 1 },
        "reviewedHosts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "sourceConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "url", "allowedFinalUrls", "mode", "format", "signals", "signalsConfidence", "limitations"],
      "properties": {
        "sourceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
        "url": { "type": "string", "pattern": "^https://" },
        "allowedFinalUrls": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^https://" } },
        "mode": { "enum": ["static-bytes", "semantic-signals"] },
        "format": { "type": ["string", "null"], "enum": ["json", "text", null] },
        "signals": { "type": "array", "items": { "$ref": "#/$defs/signal" } },
        "signalsConfidence": { "type": ["string", "null"], "enum": ["limited", null] },
        "limitations": { "type": ["array", "null"], "items": { "type": "string", "minLength": 1 } }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "literal"],
      "properties": {
        "kind": { "enum": ["address", "symbol", "lifecycle-phrase"] },
        "literal": { "type": "string", "minLength": 1 }
      }
    },
    "sourceBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "baselineKind", "sources"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "baselineKind": { "const": "source-baseline" },
        "description": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "minItems": 41,
          "maxItems": 41,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceId", "fingerprint", "mode", "approvedFinalUrls"],
            "properties": {
              "sourceId": { "type": "string", "minLength": 1 },
              "fingerprint": { "$ref": "#/$defs/sha256" },
              "mode": { "enum": ["static-bytes", "semantic-signals"] },
              "approvedFinalUrls": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^https://" } }
            }
          }
        }
      }
    }
  }
}
