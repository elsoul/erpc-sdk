{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erpc-sdk.dev/registry/rpc-network-contract.schema.json",
  "title": "RPC network contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractVersion", "transportContractVersion", "asOfDate", "contentDigest", "claimBoundaries", "methodSets", "transportProfiles", "clientContracts", "networks", "compatibilityExceptions", "languageBindings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractVersion": { "const": "1.0.0" },
    "transportContractVersion": { "const": "1.0" },
    "asOfDate": { "$ref": "#/$defs/date" },
    "contentDigest": { "$ref": "#/$defs/digest" },
    "claimBoundaries": { "$ref": "#/$defs/claimBoundaries" },
    "methodSets": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "$ref": "#/$defs/methodSet" } },
    "transportProfiles": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/transportProfile" } },
    "clientContracts": { "type": "array", "minItems": 18, "maxItems": 18, "items": { "$ref": "#/$defs/clientContract" } },
    "networks": { "type": "array", "minItems": 20, "maxItems": 20, "items": { "$ref": "#/$defs/network" } },
    "compatibilityExceptions": { "type": "array", "minItems": 19, "maxItems": 19, "items": { "$ref": "#/$defs/exception" } },
    "languageBindings": { "type": "array", "minItems": 75, "maxItems": 75, "items": { "$ref": "#/$defs/languageBinding" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000\\r\\n].*$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "claimBoundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventoryIsReadiness", "contractIsImplementationProof", "generatedProjectionIsNativeExecutionProof", "packageStatusIncluded", "liveObservationIncluded", "supportClaimIncluded"],
      "properties": {
        "inventoryIsReadiness": { "const": false },
        "contractIsImplementationProof": { "const": false },
        "generatedProjectionIsNativeExecutionProof": { "const": false },
        "packageStatusIncluded": { "const": false },
        "liveObservationIncluded": { "const": false },
        "supportClaimIncluded": { "const": false }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilityId", "publicOperation", "wireOperation", "requestEncoding", "parameterShape", "responseShape", "effect"],
      "properties": {
        "capabilityId": { "$ref": "#/$defs/id" },
        "publicOperation": { "$ref": "#/$defs/text" },
        "wireOperation": { "$ref": "#/$defs/text" },
        "requestEncoding": { "enum": ["json-rpc", "grpc-web-unary"] },
        "parameterShape": { "enum": ["none", "positional", "fixed-named"] },
        "responseShape": { "$ref": "#/$defs/text" },
        "effect": { "const": "read" },
        "publicNames": { "type": "object", "additionalProperties": { "$ref": "#/$defs/text" }, "minProperties": 5, "maxProperties": 5 },
        "parameterPolicy": { "type": "object", "additionalProperties": false, "required": ["kind", "wireParams", "nativeParameterTypes"], "properties": { "kind": { "enum": ["none", "positional", "fixed-named"] }, "wireParams": {}, "nativeParameterTypes": { "type": "object", "minProperties": 5, "maxProperties": 5, "additionalProperties": { "$ref": "#/$defs/text" } } } },
        "nativeResultTypes": { "type": "object", "minProperties": 5, "maxProperties": 5, "additionalProperties": { "$ref": "#/$defs/text" } }
      }
    },
    "methodSet": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["methodSetId", "kind", "catalogRef"],
          "properties": { "methodSetId": { "$ref": "#/$defs/id" }, "kind": { "const": "legacy-reference" }, "catalogRef": { "const": "scripts/verify-method-parity.mjs" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["methodSetId", "kind", "capabilities"],
          "properties": { "methodSetId": { "$ref": "#/$defs/id" }, "kind": { "const": "expanded" }, "capabilities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/capability" } } }
        }
      ]
    },
    "transportProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transportProfileId", "protocol", "targetRule", "authPolicy", "headerPolicy", "attempts", "redirectPolicy", "retryPolicy", "responsePolicy", "timeoutPolicy", "cancellationPolicy", "privacyPolicyId"],
      "properties": {
        "transportProfileId": { "$ref": "#/$defs/id" },
        "protocol": { "$ref": "#/$defs/text" },
        "targetRule": { "$ref": "#/$defs/text" },
        "authPolicy": { "$ref": "#/$defs/text" },
        "headerPolicy": { "$ref": "#/$defs/text" },
        "attempts": { "type": "integer", "minimum": 0, "maximum": 1 },
        "redirectPolicy": { "enum": ["reject", "none"] },
        "retryPolicy": { "const": "none" },
        "responsePolicy": { "$ref": "#/$defs/text" },
        "timeoutPolicy": { "$ref": "#/$defs/text" },
        "cancellationPolicy": { "$ref": "#/$defs/text" },
        "privacyPolicyId": { "$ref": "#/$defs/id" }
      }
    },
    "endpointMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "transportProfileId", "publicDefault", "defaultTarget", "edgeOverride", "routeRule"],
      "properties": {
        "mode": { "enum": ["hosted", "direct", "unconfigured"] },
        "transportProfileId": { "$ref": "#/$defs/id" },
        "publicDefault": { "type": ["string", "null"] },
        "defaultTarget": { "type": ["string", "null"] },
        "edgeOverride": { "type": ["string", "null"] },
        "routeRule": { "type": ["string", "null"] }
      }
    },
    "responsePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "duplicateKeyPolicy", "tuplePolicy", "limitApplicability", "limits", "integerProjection"],
      "properties": {
        "policyId": { "const": "bitcoin-exact-json-v1" },
        "duplicateKeyPolicy": { "const": "last-occurrence-wins" },
        "tuplePolicy": { "const": "sign-coefficient-exponent10-v1" },
        "limitApplicability": { "const": ["typescript", "python", "go", "ruby"] },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decodedEntityBytes", "containerDepth", "jsonTokens", "numericLexemeBytes", "coefficientDigits", "explicitExponentMin", "explicitExponentMax", "canonicalExponentMin", "canonicalExponentMax"],
          "properties": {
            "decodedEntityBytes": { "const": 67108864 },
            "containerDepth": { "const": 64 },
            "jsonTokens": { "const": 1000000 },
            "numericLexemeBytes": { "const": 1024 },
            "coefficientDigits": { "const": 1000 },
            "explicitExponentMin": { "const": -10000 },
            "explicitExponentMax": { "const": 10000 },
            "canonicalExponentMin": { "const": -10000 },
            "canonicalExponentMax": { "const": 10000 }
          }
        },
        "integerProjection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "grammar", "minimum", "maximum", "rejectForms"],
          "properties": {
            "operation": { "const": "getblockcount" },
            "grammar": { "const": "unsigned-integer-token" },
            "minimum": { "const": "0" },
            "maximum": { "const": "18446744073709551615" },
            "rejectForms": { "const": ["negative", "fraction", "exponent"] }
          }
        }
      }
    },
    "clientContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientContractId", "chainKey", "namespace", "surfaceClass", "protocolFamily", "methodSetId", "endpointModes", "endpointDiagnosticPolicyId", "networkIds", "forbiddenCapabilities", "compatibilityExceptionIds", "nativeBindingStatus"],
      "properties": {
        "clientContractId": { "$ref": "#/$defs/id" },
        "chainKey": { "$ref": "#/$defs/id" },
        "namespace": { "$ref": "#/$defs/text" },
        "surfaceClass": { "enum": ["legacy-reference", "sealed-read", "bounded-binary-read"] },
        "protocolFamily": { "enum": ["evm-jsonrpc", "solana-jsonrpc", "avalanche-jsonrpc", "bitcoin-jsonrpc", "near-jsonrpc", "tron-evm-compatible-jsonrpc", "sui-grpc-web"] },
        "methodSetId": { "$ref": "#/$defs/id" },
        "endpointModes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/endpointMode" } },
        "endpointDiagnosticPolicyId": { "$ref": "#/$defs/id" },
        "networkIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "forbiddenCapabilities": { "type": "array", "items": { "enum": ["raw", "request", "batch", "transport", "websocket", "subscription", "sign", "send", "approve", "broadcast", "swap", "bridge"] } },
        "compatibilityExceptionIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "responsePolicy": { "$ref": "#/$defs/responsePolicy" },
        "nativeBindingStatus": { "enum": ["approved-c1", "pending-later-brief"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "asOfDate"],
      "properties": { "source": { "$ref": "#/$defs/text" }, "asOfDate": { "$ref": "#/$defs/date" } }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe", "parameters", "projection", "expected", "evidence"],
      "properties": {
        "probe": { "$ref": "#/$defs/text" },
        "parameters": { "type": "array" },
        "projection": { "$ref": "#/$defs/text" },
        "expected": { "type": ["string", "number", "boolean"] },
        "secondaryProbe": { "$ref": "#/$defs/text" },
        "secondaryParameters": { "type": "array" },
        "secondaryProjection": { "$ref": "#/$defs/text" },
        "secondaryExpected": { "type": ["string", "number", "boolean"] },
        "caip2": { "$ref": "#/$defs/text" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "chain", "network", "protocols"],
      "properties": { "id": { "$ref": "#/$defs/text" }, "chain": { "$ref": "#/$defs/text" }, "network": { "$ref": "#/$defs/text" }, "protocols": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } } }
    },
    "inventoryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "sourceSha256", "observedAt", "endpointId", "limitations"],
      "properties": { "sourceId": { "$ref": "#/$defs/text" }, "sourceSha256": { "$ref": "#/$defs/digest" }, "observedAt": { "$ref": "#/$defs/text" }, "endpointId": { "$ref": "#/$defs/text" }, "limitations": { "$ref": "#/$defs/text" } }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["networkId", "chainKey", "namespace", "clientContractId", "provider", "selection", "identity", "cohort", "inventoryEvidence"],
      "properties": {
        "networkId": { "$ref": "#/$defs/id" },
        "chainKey": { "$ref": "#/$defs/id" },
        "namespace": { "$ref": "#/$defs/text" },
        "clientContractId": { "$ref": "#/$defs/id" },
        "provider": { "$ref": "#/$defs/provider" },
        "selection": { "enum": ["hosted-or-explicit-direct", "explicit-direct-only"] },
        "identity": { "$ref": "#/$defs/identity" },
        "cohort": { "type": "integer", "minimum": 0, "maximum": 5 },
        "inventoryEvidence": { "$ref": "#/$defs/inventoryEvidence" }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exceptionId", "language", "clientContractId", "allowedDifference", "evidence", "reviewCondition"],
      "properties": { "exceptionId": { "$ref": "#/$defs/id" }, "language": { "enum": ["typescript", "rust", "python", "go", "ruby"] }, "clientContractId": { "$ref": "#/$defs/id" }, "allowedDifference": { "$ref": "#/$defs/text" }, "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }, "reviewCondition": { "$ref": "#/$defs/text" } }
    },
    "languageBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindingId", "language", "clientContractId", "status", "capabilityIds", "exceptionIds"],
      "properties": { "bindingId": { "$ref": "#/$defs/id" }, "language": { "enum": ["typescript", "rust", "python", "go", "ruby"] }, "clientContractId": { "$ref": "#/$defs/id" }, "status": { "enum": ["approved-c1", "approved-c2", "approved-c3", "approved-c4", "approved-c5"] }, "capabilityIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }, "exceptionIds": { "type": "array", "items": { "$ref": "#/$defs/id" } } }
    }
  }
}
