{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/elsoul/erpc-sdk/blob/main/registry/dex-catalog.schema.json",
  "title": "ERPC canonical DEX and pool catalog",
  "description": "Strict source records for the offline DEX/pool catalog. Per-record evidence and as-of dates are provenance and are omitted from generated runtime records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "manualAsOf",
    "contentDigest",
    "dexDeployments",
    "poolDefinitions",
    "nativeWrapDefinitions",
    "aliases"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogVersion": { "$ref": "#/$defs/semver" },
    "manualAsOf": { "$ref": "#/$defs/date" },
    "contentDigest": { "$ref": "#/$defs/digest" },
    "dexDeployments": {
      "type": "array",
      "items": { "$ref": "#/$defs/dexDeployment" },
      "uniqueItems": true
    },
    "poolDefinitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/poolDefinition" },
      "uniqueItems": true
    },
    "nativeWrapDefinitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/nativeWrapDefinition" },
      "uniqueItems": true
    },
    "aliases": {
      "type": "array",
      "items": { "$ref": "#/$defs/alias" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "singleLineString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)[^\\r\\n\\u0000]*\\S$"
    },
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^https?://\\S+$"
      },
      "uniqueItems": true
    },
    "chainId": {
      "enum": [
        "eip155:1",
        "eip155:43114",
        "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp"
      ]
    },
    "status": {
      "enum": ["active", "legacy", "winding-down", "retired"]
    },
    "evmAddress": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "solanaAddress": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
    },
    "programAddress": {
      "type": "string",
      "minLength": 1
    },
    "dexDeployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dexDeploymentId",
        "protocolId",
        "name",
        "chainId",
        "programAddress",
        "adapterKind",
        "status",
        "replacedByDexDeploymentId",
        "evidence",
        "asOfDate"
      ],
      "properties": {
        "dexDeploymentId": { "$ref": "#/$defs/opaqueId" },
        "protocolId": { "$ref": "#/$defs/opaqueId" },
        "name": { "$ref": "#/$defs/singleLineString" },
        "chainId": { "$ref": "#/$defs/chainId" },
        "programAddress": { "$ref": "#/$defs/programAddress" },
        "adapterKind": { "$ref": "#/$defs/opaqueId" },
        "status": { "$ref": "#/$defs/status" },
        "replacedByDexDeploymentId": {
          "anyOf": [
            { "$ref": "#/$defs/opaqueId" },
            { "type": "null" }
          ]
        },
        "evidence": { "$ref": "#/$defs/evidence" },
        "asOfDate": { "$ref": "#/$defs/date" }
      },
      "allOf": [
        {
          "if": { "properties": { "chainId": { "enum": ["eip155:1", "eip155:43114"] } } },
          "then": { "properties": { "programAddress": { "$ref": "#/$defs/evmAddress" } } }
        },
        {
          "if": { "properties": { "chainId": { "const": "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp" } } },
          "then": { "properties": { "programAddress": { "$ref": "#/$defs/solanaAddress" } } }
        }
      ]
    },
    "feeValue": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        { "type": "null" }
      ]
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "feeNumerator", "feeDenominator"],
      "properties": {
        "kind": { "$ref": "#/$defs/opaqueId" },
        "feeNumerator": { "$ref": "#/$defs/feeValue" },
        "feeDenominator": { "$ref": "#/$defs/feeValue" }
      }
    },
    "poolDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "poolDefinitionId",
        "dexDeploymentId",
        "chainId",
        "address",
        "token0DeploymentId",
        "token1DeploymentId",
        "adapter",
        "status",
        "replacedByPoolDefinitionId",
        "evidence",
        "asOfDate"
      ],
      "properties": {
        "poolDefinitionId": { "$ref": "#/$defs/opaqueId" },
        "dexDeploymentId": { "$ref": "#/$defs/opaqueId" },
        "chainId": { "$ref": "#/$defs/chainId" },
        "address": { "$ref": "#/$defs/programAddress" },
        "token0DeploymentId": { "$ref": "#/$defs/opaqueId" },
        "token1DeploymentId": { "$ref": "#/$defs/opaqueId" },
        "adapter": { "$ref": "#/$defs/adapter" },
        "status": { "$ref": "#/$defs/status" },
        "replacedByPoolDefinitionId": {
          "anyOf": [
            { "$ref": "#/$defs/opaqueId" },
            { "type": "null" }
          ]
        },
        "evidence": { "$ref": "#/$defs/evidence" },
        "asOfDate": { "$ref": "#/$defs/date" }
      },
      "allOf": [
        {
          "if": { "properties": { "chainId": { "enum": ["eip155:1", "eip155:43114"] } } },
          "then": { "properties": { "address": { "$ref": "#/$defs/evmAddress" } } }
        },
        {
          "if": { "properties": { "chainId": { "const": "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp" } } },
          "then": { "properties": { "address": { "$ref": "#/$defs/solanaAddress" } } }
        }
      ]
    },
    "nativeWrapDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nativeWrapDefinitionId",
        "chainId",
        "nativeTokenDeploymentId",
        "wrappedTokenDeploymentId",
        "status",
        "evidence",
        "asOfDate"
      ],
      "properties": {
        "nativeWrapDefinitionId": { "$ref": "#/$defs/opaqueId" },
        "chainId": { "$ref": "#/$defs/chainId" },
        "nativeTokenDeploymentId": { "$ref": "#/$defs/opaqueId" },
        "wrappedTokenDeploymentId": { "$ref": "#/$defs/opaqueId" },
        "status": { "$ref": "#/$defs/status" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "asOfDate": { "$ref": "#/$defs/date" }
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "name",
        "dexDeploymentId",
        "poolDefinitionId",
        "evidence",
        "asOfDate"
      ],
      "properties": {
        "namespace": {
          "enum": ["ethereum", "solana", "avalancheC"]
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "dexDeploymentId": {
          "anyOf": [
            { "$ref": "#/$defs/opaqueId" },
            { "type": "null" }
          ]
        },
        "poolDefinitionId": {
          "anyOf": [
            { "$ref": "#/$defs/opaqueId" },
            { "type": "null" }
          ]
        },
        "evidence": { "$ref": "#/$defs/evidence" },
        "asOfDate": { "$ref": "#/$defs/date" }
      },
      "oneOf": [
        {
          "required": ["dexDeploymentId"],
          "properties": { "dexDeploymentId": { "type": "string" }, "poolDefinitionId": { "type": "null" } }
        },
        {
          "required": ["poolDefinitionId"],
          "properties": { "dexDeploymentId": { "type": "null" }, "poolDefinitionId": { "type": "string" } }
        }
      ]
    }
  }
}
