{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/elsoul/erpc-sdk/blob/main/registry/token-rankings.schema.json",
  "title": "ERPC token ranking artifact",
  "description": "A source-backed, bounded snapshot of token values. Ranking values are reduced integer rationals; unavailable observations stay unranked.",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "records", "unranked", "provenance"],
  "properties": {
    "metadata": { "$ref": "#/$defs/metadata" },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" },
      "uniqueItems": true
    },
    "unranked": {
      "type": "array",
      "items": { "$ref": "#/$defs/unranked" },
      "uniqueItems": true
    },
    "provenance": {
      "type": "array",
      "items": { "$ref": "#/$defs/provenance" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "singleLineString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)[^\\r\\n\\u0000]*\\S$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "rfc3339": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+][0-9]{2}:[0-9]{2}|-[0-9]{2}:[0-9]{2})$"
    },
    "nonnegativeInteger": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "positiveInteger": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[1-9][0-9]*$"
    },
    "metric": {
      "enum": ["onchain-total-supply-value-native", "global-circulating-market-cap-usd"]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "metric", "asOf", "contentDigest", "status", "coverage", "sourceIds"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "metric": { "anyOf": [{ "$ref": "#/$defs/metric" }, { "type": "null" }] },
        "asOf": { "anyOf": [{ "$ref": "#/$defs/rfc3339" }, { "type": "null" }] },
        "contentDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "status": { "enum": ["unconfigured", "complete", "partial"] },
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["chainId", "totalDeployments", "rankedDeployments", "unrankedDeployments", "observedAt"],
            "properties": {
              "chainId": { "$ref": "#/$defs/id" },
              "totalDeployments": { "type": "integer", "minimum": 0 },
              "rankedDeployments": { "type": "integer", "minimum": 0 },
              "unrankedDeployments": { "type": "integer", "minimum": 0 },
              "observedAt": { "anyOf": [{ "$ref": "#/$defs/rfc3339" }, { "type": "null" }] }
            }
          }
        },
        "sourceIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "chainId", "deploymentIds", "metric", "valueNumerator", "valueDenominator", "quoteCurrency", "quoteDeploymentId", "observedAt", "sourceId", "sourceAssetId"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "chainId": { "$ref": "#/$defs/id" },
        "deploymentIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "metric": { "$ref": "#/$defs/metric" },
        "valueNumerator": { "$ref": "#/$defs/nonnegativeInteger" },
        "valueDenominator": { "$ref": "#/$defs/positiveInteger" },
        "quoteCurrency": { "enum": ["native", "USD"] },
        "quoteDeploymentId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "observedAt": { "$ref": "#/$defs/rfc3339" },
        "sourceId": { "$ref": "#/$defs/id" },
        "sourceAssetId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
      }
    },
    "unranked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chainId", "deploymentId", "reason", "sourceId", "observedAt"],
      "properties": {
        "chainId": { "$ref": "#/$defs/id" },
        "deploymentId": { "$ref": "#/$defs/id" },
        "reason": { "enum": ["unavailable", "stale", "unpriced", "invalid", "rights-denied", "below-min-native-liquidity", "excluded-native", "unsupported"] },
        "sourceId": { "$ref": "#/$defs/id" },
        "observedAt": { "anyOf": [{ "$ref": "#/$defs/rfc3339" }, { "type": "null" }] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "kind", "observedAt", "rights", "details"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["rpc", "licensed-global-provider", "replay"] },
        "observedAt": { "anyOf": [{ "$ref": "#/$defs/rfc3339" }, { "type": "null" }] },
        "rights": { "enum": ["original-rpc-facts", "licensed", "unconfigured", "unknown"] },
        "details": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
