{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/elsoul/erpc-sdk/blob/main/registry/token-catalog.schema.json",
  "title": "ERPC canonical token catalog",
  "description": "Canonical source records for the offline five-language token catalog. Evidence and per-record as-of dates are source provenance and are removed from generated SDK runtime records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "manualAsOf",
    "contentDigest",
    "assets",
    "deployments",
    "aliases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "catalogVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "manualAsOf": {
      "$ref": "#/$defs/date"
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      },
      "uniqueItems": true
    },
    "deployments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deployment"
      },
      "uniqueItems": true
    },
    "aliases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/alias"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "singleLineString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)[^\\r\\n\\u0000]*\\S$",
      "not": {
        "pattern": "[\\r\\n\\u0000]"
      }
    },
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^https?://\\S+$"
      },
      "uniqueItems": true
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "name",
        "representationKind",
        "stableCurrency",
        "underlyingAssetId",
        "economicReferenceAssetId",
        "evidence",
        "asOfDate"
      ],
      "properties": {
        "assetId": {
          "$ref": "#/$defs/opaqueId"
        },
        "name": {
          "$ref": "#/$defs/singleLineString"
        },
        "representationKind": {
          "enum": [
            "native",
            "issued",
            "wrapped",
            "bridged"
          ]
        },
        "stableCurrency": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "USD",
            "EUR",
            "JPY",
            null
          ]
        },
        "underlyingAssetId": {
          "anyOf": [
            {
              "$ref": "#/$defs/opaqueId"
            },
            {
              "type": "null"
            }
          ]
        },
        "economicReferenceAssetId": {
          "anyOf": [
            {
              "$ref": "#/$defs/opaqueId"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "asOfDate": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploymentId",
        "assetId",
        "chainId",
        "symbol",
        "decimals",
        "standard",
        "address",
        "status",
        "replacedByDeploymentId",
        "evidence",
        "asOfDate"
      ],
      "properties": {
        "deploymentId": {
          "$ref": "#/$defs/opaqueId"
        },
        "assetId": {
          "$ref": "#/$defs/opaqueId"
        },
        "chainId": {
          "enum": [
            "eip155:1",
            "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp",
            "eip155:43114"
          ]
        },
        "symbol": {
          "$ref": "#/$defs/singleLineString"
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "standard": {
          "enum": [
            "native",
            "erc20",
            "spl-token",
            "spl-token-2022"
          ]
        },
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "active",
            "legacy",
            "winding-down",
            "retired"
          ]
        },
        "replacedByDeploymentId": {
          "anyOf": [
            {
              "$ref": "#/$defs/opaqueId"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "asOfDate": {
          "$ref": "#/$defs/date"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "standard": {
                "const": "native"
              }
            }
          },
          "then": {
            "properties": {
              "address": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "address": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "standard": {
                "const": "erc20"
              }
            }
          },
          "then": {
            "properties": {
              "chainId": {
                "enum": [
                  "eip155:1",
                  "eip155:43114"
                ]
              },
              "address": {
                "pattern": "^0x[0-9a-f]{40}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "standard": {
                "enum": [
                  "spl-token",
                  "spl-token-2022"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "chainId": {
                "const": "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp"
              },
              "address": {
                "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
              }
            }
          }
        }
      ]
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "name",
        "deploymentId"
      ],
      "properties": {
        "namespace": {
          "enum": [
            "ethereum",
            "solana",
            "avalancheC"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "deploymentId": {
          "$ref": "#/$defs/opaqueId"
        }
      }
    }
  }
}
